{
  "identifier": "default",
  "description": "Default permissions for Ori Studio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:menu:default",
    "core:webview:allow-print",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
